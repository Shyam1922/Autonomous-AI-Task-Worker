APP_NAME=TaskPilot
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://taskpilot:taskpilot_dev_password@localhost:5432/taskpilot_db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM: "auto" uses Claude when ANTHROPIC_API_KEY is set, otherwise the offline mock planner.
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium

# Execution limits
MAX_STEPS_PER_TASK=30
MAX_RETRIES_PER_STEP=2
TOOL_TIMEOUT_SECONDS=30
REQUIRE_APPROVAL_FOR_WRITES=true
